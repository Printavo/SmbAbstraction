{
  // TODO: Update these settings in appsettings.gitignore.json (not the template version) before running the integration tests. To run these tests, you must first do several things:
  // 1. Make sure you have a designated account on the host to which you are connecting via SMB. If it's a domain account, set the domain name in the "Domain" property. If it's a local account, set the server name in the "Domain" property. Set the username and password in the "Username" and "Password" properties, respectively. No slash characters in either the domain or username properties.
  // 2. Make sure you have a share on the host to which you are connecting via SMB. Set the host name in the "HostName" property. Set the share name in the "ShareName" property. Make sure the given user account has modify access to this share.
  // 3. You must create the "Dir" directory on the file share ahead of running tests, and also create a "file.txt" file in the share root with some arbitrary file contents before running the tests.
  // 4. Set the "LocalTempFolder" property to a local directory for testing copy files from local to remote.

  // NOTE/WARNING: Adam was lazy with some of these tests, so the tests will leave some garbage in the destination file share that you'll need to clean out, occasionally.
  "IntegrationTestSettings": {
    "ShareCredentials": {
      "Domain": "DomainOrServerNameHere",
      "Username": "UsernameHere",
      "Password": "UserPasswordHere"
    },
    "Shares": [
      {
        "HostName": "HostNameHere",
        "ShareName": "ShareNameHere",
        "Files": [
          "file.txt"
        ],
        "Directories": [
          "Dir"
        ]
      }
    ],
    "LocalTempFolder": "C:\\Temp"
  }
}
